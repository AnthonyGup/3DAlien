// Ejemplo Zetariano: cubre todo el lenguaje.
// El archivo se llama igual que la clase (regla del spec).
public class Persona {
    int edad;
    String nombre;
    double promedio;
    char inicial;
    boolean activo;
    int[] notas;
    String[] apodos;
    Persona mejorAmigo;

    public Persona() {
        edad = 0;
        nombre = "desconocido";
        promedio = 0.0;
        inicial = 'X';
        activo = false;
        notas = new int[3];
        apodos = new String[2];
        mejorAmigo = null;
    }

    public Persona(String n, int e) {
        nombre = n;
        edad = e;
        promedio = 10.0;
        inicial = 'P';
        activo = true;
        notas = new int[5];
        apodos = new String[2];
        mejorAmigo = null;
    }

    public void saludar() {
        println("hola, soy " + nombre);
    }

    public String saludar(String prefijo) {
        return prefijo + " " + nombre;
    }

    public int sumar(int a, int b) {
        return a + b;
    }

    public void cumpleanos() {
        edad += 1;
        nombre += "!";
        edad++;
        return;
    }

    public double promedioNotas() {
        double suma = 0.0;
        int i = 0;
        while (i < 3) {
            suma = suma + notas[i];
            i = i + 1;
        }
        return suma / 3;
    }

    public String estado() {
        String e = activo ? "activo" : "inactivo";
        return e;
    }

    public void clasificar() {
        if (edad < 0) edad = 0;
        if (edad < 13) {
            println("nino");
        } else if (edad < 18) {
            println("adolescente");
        } else {
            println("adulto");
        }
        switch (edad) {
            case 0:
            case 1:
                println("bebe");
                break;
            case 18:
                println("mayoria de edad");
                break;
            default:
                println("otra edad");
        }
    }

    public int[] primeros(int[] arr) {
        int[] copia = new int[3];
        copia[0] = arr[0];
        return copia;
    }

    public void probarTodo() {
        int x = 10;
        x -= 2;
        x *= 3;
        int r = x % 4;
        boolean b = !(x == 0) && (x >= 8 || x <= 30);
        int[] primos = {2, 3, 5};
        int[][] m = new int[2][3];
        m[0][1] = 7;
        Persona[] grupo = new Persona[2];
        grupo[0] = new Persona("ali", 20);
        Persona amigo = new Persona("ali", 20);
        amigo.saludar();
        saludar("buenos dias");
        if (mejorAmigo == null) {
            mejorAmigo = amigo;
        }
        for (int k = 0; k < 3; k++) {
            println(primos[k]);
        }
        int i = 0;
        for (i = 0; i < 2; i++) {
            println(i);
        }
        for (;;) {
            x = x - 1;
            if (x <= 0) break;
        }
        do {
            x = x + 1;
        } while (x < 5);
        {
            int dentro = 1;
            println(dentro);
        }
        x--;
        println(b);
        println(r);
        return;
    }
}
